# ── Servis ────────────────────────────────────────────────────────────────
KITAPAI_HOST=0.0.0.0
KITAPAI_PORT=8000

# Model motoru: transformers | openai | stub
#   transformers → yerel 4-bit + LoRA (CUDA)
#   openai       → llama.cpp / vLLM gibi OpenAI-uyumlu bir sunucuya proxy
#   stub         → modelsiz deterministik mod (geliştirme/test)
KITAPAI_ENGINE=transformers
KITAPAI_BASE_MODEL=unsloth/Qwen2.5-3B-Instruct-bnb-4bit
KITAPAI_ADAPTER_PATH=models/kitapai-lora
KITAPAI_MAX_NEW_TOKENS=700

# openai motoru için
# KITAPAI_OPENAI_BASE_URL=http://127.0.0.1:8080/v1
# KITAPAI_OPENAI_MODEL=kitapai
# KITAPAI_OPENAI_API_KEY=sk-yok

# ── Veri ──────────────────────────────────────────────────────────────────
KITAPAI_CATALOG_PATH=data/catalog.duckdb
KITAPAI_EMBEDDING_MODEL=intfloat/multilingual-e5-small
KITAPAI_VECTORS_PATH=data/vectors

# ── Erişim ────────────────────────────────────────────────────────────────
# Boş bırakılırsa kimlik doğrulama kapalı. Tailscale dışına açacaksan doldur.
KITAPAI_API_KEY=
# Virgülle ayrılmış origin listesi; "*" tüm origin'lere izin verir.
KITAPAI_CORS_ORIGINS=*
